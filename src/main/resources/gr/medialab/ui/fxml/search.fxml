<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="gr.medialab.ui.controllers.SearchController"
      spacing="10">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <Label text="Search Documents" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Category:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="categoryCombo" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="240"/>

        <Label text="Title:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Author:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="authorField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Button text="Search" onAction="#onSearch" GridPane.rowIndex="1" GridPane.columnIndex="3" maxWidth="Infinity"/>
    </GridPane>

    <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="titleCol" text="Title" prefWidth="220"/>
            <TableColumn fx:id="authorCol" text="Author" prefWidth="160"/>
            <TableColumn fx:id="categoryCol" text="Category" prefWidth="140"/>
            <TableColumn fx:id="createdAtCol" text="Created At" prefWidth="180"/>
            <TableColumn fx:id="versionCol" text="Version" prefWidth="80"/>
        </columns>
    </TableView>

</VBox>